# Copy to .env.local (development) or set in your hosting provider (production).
# Never commit real values.

# ---------------------------------------------------------------- Site
# Public website URL (canonical links, sitemap, Open Graph). Set before building.
NEXT_PUBLIC_SITE_URL=https://www.example.com
# Base URL for links in CRM emails (invites, resets, alerts).
# Defaults to https://CRM_HOST when that is set, otherwise NEXT_PUBLIC_SITE_URL.
APP_URL=
# Optional: serve the CRM on its own subdomain, e.g. crm.example.com (no https://).
# When set, /crm on the public site redirects there. Leave empty to keep the CRM at /crm.
CRM_HOST=

# ---------------------------------------------------------------- Database
# Production: a PostgreSQL connection string (Neon: use the POOLED string with "-pooler").
# Leave empty for local development to use the embedded PGlite database in ./.data/pglite.
DATABASE_URL=
# Set to "true" if your provider requires TLS (Neon, Supabase and most managed services do).
DATABASE_SSL=
# Connections per server instance. Use 3 on serverless hosts such as Vercel.
DATABASE_POOL_MAX=
# "true" = apply migrations automatically when the server starts (PostgreSQL only).
DATABASE_AUTO_MIGRATE=
# Optional: location of the local PGlite database (development only).
PGLITE_DATA_DIR=

# ---------------------------------------------------------------- CRM first-time setup
# A long random value (at least 16 characters). Enables /crm/setup ONLY while no
# users exist. Remove it after the first Owner account has been created.
CRM_SETUP_TOKEN=

# ---------------------------------------------------------------- Daily job
# A long random value (at least 16 characters). Vercel Cron sends it automatically
# to /api/cron/daily, which creates task reminders and sends queued emails.
CRON_SECRET=

# ---------------------------------------------------------------- Email (optional: choose ONE)
# Enables: new-inquiry emails, CRM invitations, password resets, and email alerts.
# Without email, the CRM still works and shows one-time links for admins to share.

# Option A: SMTP (works without your own domain, e.g. a Gmail account + app password)
#   Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=465, SMTP_USER=you@gmail.com, SMTP_PASS=<16-char app password>
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
# Optional: "true" for port 465 (TLS), "false" for 587 (STARTTLS). Chosen from the port if empty.
SMTP_SECURE=

# Option B: Resend (https://resend.com), best once you own a domain
RESEND_API_KEY=

# Sender shown on emails, e.g. "Vortix CRM <crm@example.com>". Required for Resend;
# with SMTP it defaults to SMTP_USER.
CONTACT_FROM_EMAIL=
# Optional shared inbox that also receives every website inquiry (comma-separated).
CONTACT_TO_EMAIL=

# ---------------------------------------------------------------- Webhook (optional)
# Forward each website inquiry (as JSON) to another system after it is saved in the CRM.
CONTACT_WEBHOOK_URL=
