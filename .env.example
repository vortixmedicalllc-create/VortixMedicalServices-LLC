# Copy to .env.local (development) or set in your hosting provider (production).
# Never commit real values.

# ---------------------------------------------------------------- Site
# Public website URL (canonical links, sitemap, Open Graph).
NEXT_PUBLIC_SITE_URL=https://www.example.com
# Base URL used in CRM emails and invite/reset links. Defaults to NEXT_PUBLIC_SITE_URL.
APP_URL=

# ---------------------------------------------------------------- Database
# Production: a PostgreSQL connection string. Run `npm run db:migrate` after setting it.
# Leave empty for local development to use the embedded PGlite database in ./.data/pglite.
DATABASE_URL=
# Set to "true" if your provider requires TLS (most managed Postgres services do).
DATABASE_SSL=
# Optional: apply migrations automatically when the server starts (PostgreSQL only).
DATABASE_AUTO_MIGRATE=
# Optional: location of the local PGlite database (development only).
PGLITE_DATA_DIR=

# ---------------------------------------------------------------- CRM first-time setup
# A long random value (at least 16 characters). Enables /crm/setup ONLY while no
# users exist. Remove it after the first Owner account has been created.
CRM_SETUP_TOKEN=

# ---------------------------------------------------------------- Email (optional, Resend)
# Enables: new website inquiry emails, CRM invitations, password reset emails.
# Without these, the CRM still works and shows one-time links for admins to share.
RESEND_API_KEY=
CONTACT_FROM_EMAIL=
# Optional extra recipients for new-inquiry emails (comma-separated).
CONTACT_TO_EMAIL=

# ---------------------------------------------------------------- Webhook (optional)
# Forward each website inquiry (as JSON) to another system after it is saved in the CRM.
CONTACT_WEBHOOK_URL=
